#usda 1.0

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "TexcoordMaterial"
        {
            token outputs:mtlx:surface.connect = </World/Looks/TexcoordMaterial/Surface.outputs:out>

            def Shader "TexcoordSource"
            {
                uniform token info:id = "ND_combine2_vector2"
                float inputs:in1 = 0.125
                float inputs:in2 = 0.875
                token outputs:out
            }

            def Shader "ConnectedConsumer"
            {
                uniform token info:id = "ND_checkerboard_color3"
                float2 inputs:texcoord.connect = </World/Looks/TexcoordMaterial/TexcoordSource.outputs:out>
                token outputs:out
            }

            def Shader "LiteralConsumer"
            {
                uniform token info:id = "ND_checkerboard_color3"
                float2 inputs:texcoord = (0.25, 0.75)
                token outputs:out
            }

            def Shader "ImplicitConsumer"
            {
                uniform token info:id = "ND_checkerboard_color3"
                token outputs:out
            }

            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                color3f inputs:base_color.connect = </World/Looks/TexcoordMaterial/ConnectedConsumer.outputs:out>
                token outputs:out
            }
        }
    }
    def Mesh "Triangle" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        rel material:binding = </World/Looks/TexcoordMaterial>
    }
}
